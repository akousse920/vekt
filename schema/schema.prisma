generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "sqlite"
}

model Job {
  id                  String              @id @default(cuid())
  slug                String              @unique
  title               String
  description         String
  location            String?
  customPrompt        String?
  threshold           Int                 @default(75)
  isActive            Boolean             @default(true)
  notifyOnApplication Boolean             @default(true)
  applicationDeadline DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  candidates          Candidate[]
  views               JobView[]
  screeningQuestions  ScreeningQuestion[]
  screeningRules      ScreeningRule[]
  rubricCriteria      RubricCriterion[]
  applicationFields   ApplicationField[]
  applicationRules    ApplicationRule[]
  createdById         String?
  createdBy           User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

model ScreeningQuestion {
  id      String            @id @default(cuid())
  jobId   String
  job     Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  text    String
  type    QuestionType      @default(SINGLE)
  order   Int               @default(0)
  options ScreeningOption[]
  answers CandidateAnswer[]
  textAnswers CandidateTextAnswer[]
  rules   ScreeningRule[]
}

model ScreeningRule {
  id         String            @id @default(cuid())
  jobId      String
  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  questionId String
  question   ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  operator   ScreeningOperator
  value      String
  mandatory  Boolean           @default(true)
  createdAt  DateTime          @default(now())
}

model RubricCriterion {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  label     String
  weight    Int
  required  Boolean  @default(false)
  order     Int      @default(0)

  @@index([jobId])
}

model ScreeningOption {
  id         String            @id @default(cuid())
  questionId String
  question   ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  order      Int               @default(0)
  answers    CandidateAnswer[]
}

model CandidateAnswer {
  id          String            @id @default(cuid())
  candidateId String
  candidate   Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  questionId  String
  question    ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId    String
  option      ScreeningOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([candidateId, questionId, optionId])
}

model CandidateTextAnswer {
  id          String            @id @default(cuid())
  candidateId String
  candidate   Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  questionId  String
  question    ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String

  @@unique([candidateId, questionId])
}

model JobView {
  id       String   @id @default(cuid())
  jobId    String
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  referrer String?
  viewedAt DateTime @default(now())
}

/// Extra fields shown on the public application form. Changes are locked after
/// the first application so stored answers retain their original meaning.
model ApplicationField {
  id               String              @id @default(cuid())
  jobId            String
  job              Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  key              String
  label            String
  type             ApplicationFieldType
  required         Boolean             @default(false)
  options          String               @default("[]")
  minValue         Float?
  maxValue         Float?
  flagOutsideRange Boolean             @default(false)
  maxFiles         Int                 @default(1)
  order            Int                 @default(0)
  answers          ApplicationAnswer[]

  @@unique([jobId, key])
  @@index([jobId, order])
}

model ApplicationAnswer {
  id          String           @id @default(cuid())
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fieldId     String
  field       ApplicationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  /// JSON string for multi-select; file path for PDF; plain string otherwise.
  value       String

  @@unique([candidateId, fieldId])
}

/// Expected answers on one or more application fields. A failed REVIEW rule
/// sends the dossier to a person; a failed FLAG rule only adds a visible flag.
model ApplicationRule {
  id         String                @id @default(cuid())
  jobId      String
  job        Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  key        String
  label      String
  mode       ApplicationRuleMode   @default(ALL)
  action     ApplicationRuleAction @default(FLAG)
  conditions String
  order      Int                   @default(0)

  @@unique([jobId, key])
  @@index([jobId, order])
}

/// Informational only: flags never alter status, AI score or routing.
model CandidateFlag {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// Identifier of the field or application rule that raised the flag.
  fieldId     String
  detail      String
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

model Candidate {
  id                   String          @id @default(cuid())
  name                 String
  email                String
  resumePath           String
  resumeText           String          @default("")
  status               CandidateStatus @default(APPLIED)
  appliedAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  jobId                String?
  job                  Job?            @relation(fields: [jobId], references: [id])
  evaluation           Evaluation?
  consentGiven         Boolean         @default(false)
  consentAt            DateTime?
  criteriaDeclaredAt   DateTime?
  privacyPolicyVersion String?
  emailOptOut          Boolean         @default(false)
  emailLogs            EmailLog[]
  answers              CandidateAnswer[]
  textAnswers          CandidateTextAnswer[]
  decisionReasons      DecisionReason[]
  applicationAnswers   ApplicationAnswer[]
  flags                CandidateFlag[]
}

model DecisionReason {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage       String
  ruleId      String?
  detail      String
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

/// Record of a single AI evaluation.
/// Provenance fields (provider/model/promptHash/evaluatorVersion) exist so a
/// decision can be traced after the fact, as required for high-risk systems by
/// EU AI Act Art. 12. Do not drop them: models get deprecated and prompts get
/// edited, and without these a stored score cannot be explained or reproduced.
model Evaluation {
  id               String   @id @default(cuid())
  score            Int
  reasoning        String
  pros             String   // JSON array stored as string
  cons             String   // JSON array stored as string
  promptSnapshot   String
  /// AI_PROVIDER in effect when this evaluation ran (mock/openai/openrouter/ollama)
  provider         String   @default("unknown")
  /// Exact model identifier returned by the provider adapter
  model            String   @default("unknown")
  /// SHA-256 of the full system + user prompt
  promptHash       String   @default("")
  /// EVALUATOR_VERSION from lib/ai.ts at evaluation time
  evaluatorVersion String   @default("")
  /// JSON object of identifier redaction counts, e.g. {"email":1,"name":3}
  redactions       String   @default("{}")
  /// JSON snapshot of the per-job weighted rubric in force at evaluation time.
  rubricSnapshot   String   @default("[]")
  /// JSON array of criterion scores and evidence returned by the model.
  rubricBreakdown  String   @default("[]")
  /// True if the deployer had AUTO_REJECT_BELOW_THRESHOLD enabled at the time
  autoDecision     Boolean  @default(false)
  createdAt        DateTime @default(now())
  candidateId      String    @unique
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("RECRUITER")
  createdAt DateTime @default(now())
  jobs      Job[]
}

/// Key-value store for admin-controlled global settings (e.g. RETENTION_DAYS)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Email template stored in the database and editable by admins
model EmailTemplate {
  type      EmailType @id
  subject   String
  body      String // HTML; supports {{candidateName}}, {{jobTitle}}, {{companyName}}, {{statusPageUrl}}, {{retentionDate}}
  updatedAt DateTime  @updatedAt
}

/// Audit log of every outbound candidate email
model EmailLog {
  id          String    @id @default(cuid())
  candidateId String
  type        EmailType
  sentAt      DateTime  @default(now())
  resendId    String? // Resend delivery ID for tracking
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TEXT
}

enum ApplicationFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  BIRTH_YEAR
  BIRTH_DATE
  SINGLE_SELECT
  MULTI_SELECT
  FILE
  FILES
  YES_NO
  DECLARATION
}

enum ApplicationRuleMode {
  ALL
  ANY
}

enum ApplicationRuleAction {
  FLAG
  REVIEW
}

enum ScreeningOperator {
  EQUALS
  NOT_EQUALS
  IN
  GTE
  LTE
}

enum CandidateStatus {
  APPLIED
  ANALYZING
  SHORTLISTED
  /// Scored below threshold but NOT auto-rejected — awaiting a human decision.
  NEEDS_REVIEW
  ACCEPTED
  REJECTED
}

enum EmailType {
  APPLIED
  SHORTLISTED
  REJECTED
  ACCEPTED
  DATA_RETENTION_WARNING
}
